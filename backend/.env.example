# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM ──────────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-4-maverick-17b-128e-instruct   # see context/issues/01-issue.md for options

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recon

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production
LOG_LEVEL=INFO

# ── Celery / Redis (optional, for background workers) ────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
