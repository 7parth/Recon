# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM ──────────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-4-maverick-17b-128e-instruct   # see context/issues/01-issue.md for options

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-side only — never expose to browser

# Storage bucket names (create these in Supabase Storage dashboard)
SUPABASE_STORAGE_BUCKET=resumes
SUPABASE_CHECKPOINT_BUCKET=checkpoints

# ── Database ─────────────────────────────────────────────────────────────────
# Find in: Supabase → Project Settings → Database → Connection string (URI mode)
# Change the scheme from postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production
LOG_LEVEL=INFO

# ── Celery / Redis (optional, for background workers) ────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
